# Copia este archivo como .env (en esta misma carpeta) y completa lo que necesites.
# .env nunca se sube a git: ahí vive el token del bot.

# Token del bot de Telegram (te lo da @BotFather). Sin token, HQ funciona igual pero sin bot.
TELEGRAM_BOT_TOKEN=

# Zona horaria de recordatorios y del ritual semanal
HQ_TZ=America/Bogota

# Opcional: dónde guardar la base de datos (por defecto backend/data/hq.db)
# HQ_DB_PATH=
